# Google Sheets Configuration
# Os IDs das planilhas são extraídos diretamente das URLs fornecidas
# Suporta IDs específicos por ano (ex: SPREADSHEET_BUDGET_ID_2026, SPREADSHEET_BUDGET_ID_2027, SPREADSHEET_BUDGET_ID_2028, etc.)
SPREADSHEET_BUDGET_ID_2026="planilha_2026"
SPREADSHEET_BUDGET_ID_2027="planilha_2027"
SPREADSHEET_ORDERS_ID="planilha_ordens"

# Caminho do arquivo JSON de credenciais da conta de serviço Google Cloud
# Por padrão, coloque o arquivo baixado como 'credentials.json' na pasta data/
GOOGLE_APPLICATION_CREDENTIALS="data/credentials.json"

# Senhas para faturas em PDF de cartão de crédito (6 primeiros dígitos do CPF)
PDF_INVOICE_INTER_PASSWORD="123456"
PDF_INVOICE_C6_PASSWORD="123456"

# Google Gemini AI Key
# Consiga sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Correções de dados lidos da planilha (Exemplo fictício)
CORRECOES_CONHECIDAS='{"PETR4|01/01/2026": 100.0, "VALE3|15/05/2026": 50.0}'

# Splits e Desdobramentos Oficiais (Exemplo fictício)
SPLITS_OFICIAIS='{"PETR4|2026-01-01": 2.0, "VALE3|2026-05-15": 3.0}'

# Script de remoção de linha distorcida (Exemplo fictício)
REMOVER_TICKER="TICKER3"
REMOVER_DATA="01/01/2026"

# ==============================================================================
# SEGURANÇA WEBUI & AUTENTICAÇÃO FAIL-CLOSED
# ==============================================================================
# Mantenha REQUIRE_AUTH=true em produção. O painel bloqueia inicialização sem credencial/secret.
REQUIRE_AUTH=true
# Gere o hash com: python3 -c "from src.utils.security import hash_password_pbkdf2; print(hash_password_pbkdf2('SUA_SENHA_FORTE'))"
DASHBOARD_AUTH_PASSWORD_HASH=""
# Segredo HMAC >= 16 caracteres (recomendado >= 32). Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SESSION_SECRET=""
# Whitelist de Host Headers permitidos (separados por vírgula)
ALLOWED_HOSTS="localhost,127.0.0.1"
# Bind de rede do Docker (127.0.0.1 recomendado; acesse remotamente via SSH Tunnel ou Reverse Proxy TLS)
BIND_ADDRESS="127.0.0.1"

# Porta do Servidor Streamlit
STREAMLIT_PORT=8502

# Pluggy
PLUGGY_CLIENT_ID="seu_client_id"
PLUGGY_CLIENT_SECRET="seu_client_secret"
PLUGGY_CLIENT_API_KEY=""

# ==============================================================================
# DEPLOY NO HOMELAB / MINI PC (PREENCHIMENTO OBRIGATÓRIO - FAIL-CLOSED)
# ==============================================================================
HOMELAB_HOST=192.0.2.10
HOMELAB_USER=deploy_user
HOMELAB_PORT=22
HOMELAB_DEST_DIR=/opt/stacks/paulo-investimentos-pessoais
HOMELAB_SSH_KEY=~/.ssh/id_ed25519
HOMELAB_PORT_APP=8094