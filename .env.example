# Google Sheets Configuration
# Os IDs das planilhas são extraídos diretamente das URLs fornecidas
SPREADSHEET_BUDGET_ID="google-sheets"
SPREADSHEET_ORDERS_ID="google-sheets"

# Caminho do arquivo JSON de credenciais da conta de serviço Google Cloud
# Por padrão, coloque o arquivo baixado como 'credentials.json' na raiz do projeto
GOOGLE_APPLICATION_CREDENTIALS="credentials.json"

# Google Gemini AI Key
# Consiga sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
