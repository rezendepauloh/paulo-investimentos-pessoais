# Google Sheets Configuration
# Os IDs das planilhas são extraídos diretamente das URLs fornecidas
# Suporta IDs específicos por ano (ex: SPREADSHEET_BUDGET_ID_2026, SPREADSHEET_BUDGET_ID_2027, SPREADSHEET_BUDGET_ID_2028, etc.)
SPREADSHEET_BUDGET_ID_2026="122znWvV05usgFY9K2hVAQlkjzYXm6ORfIQYdp0ynIqQ"
SPREADSHEET_BUDGET_ID_2027="15mEzxlyonOFhcG2wmQ4oCecA3U5sw_3tx_AbNsmy3VE"
SPREADSHEET_ORDERS_ID="1NAO6pSGz3xREv0ylJXhW2ZgCTw7j5b_Gs1huJkw5Aqo"

# Caminho do arquivo JSON de credenciais da conta de serviço Google Cloud
# Por padrão, coloque o arquivo baixado como 'credentials.json' na pasta data/
GOOGLE_APPLICATION_CREDENTIALS="data/credentials.json"

# Google Gemini AI Key
# Consiga sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Correções de dados lidos da planilha (Exemplo fictício)
CORRECOES_CONHECIDAS='{"PETR4|01/01/2026": 100.0, "VALE3|15/05/2026": 50.0}'

# Splits e Desdobramentos Oficiais (Exemplo fictício)
SPLITS_OFICIAIS='{"PETR4|2026-01-01": 2.0, "VALE3|2026-05-15": 3.0}'

# Script de remoção de linha distorcida (Exemplo fictício)
REMOVER_TICKER="TICKER3"
REMOVER_DATA="01/01/2026"

# Porta do Servidor Streamlit
STREAMLIT_PORT=8502

# Pluggy
PLUGGY_CLIENT_ID = "seu_client_id"
PLUGGY_CLIENT_SECRET = "seu_client_secret"
PLUGGY_CLIENT_API_KEY = "api"